{
  "name": "@deepseek-ai/dsh-tool-docx",
  "description": "Model-facing DOCX resume exporter over the DeepSeek Harness filesystem seam",
  "version": "0.1.0-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
